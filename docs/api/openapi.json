{
  "openapi": "3.0.3",
  "info": {
    "title": "Agenda ao Ar Livre - API pública",
    "version": "0.1.0",
    "description": "Contrato inicial da fase 1. Endpoints ainda não implementados. Exemplos fictícios. Limite proposto 60/min por IP. Apenas leitura pública; autenticação de sessão é da interface web."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Endereço previsto para desenvolvimento na fase 2"
    }
  ],
  "paths": {
    "/atividades/": {
      "get": {
        "operationId": "listarAtividades",
        "summary": "Consultar catálogo público",
        "description": "Filtros por AND; ordem inicio,id. Parâmetros desconhecidos causam 400. Eventos passados incluídos se não houver filtro.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Busca em título e descrição."
          },
          {
            "name": "cidade",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Cidade sem diferenciar maiúsculas."
          },
          {
            "name": "categoria",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "ID da categoria."
          },
          {
            "name": "data_inicio",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Limite inicial inclusivo da data de início no fuso America/Sao_Paulo."
          },
          {
            "name": "data_fim",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Limite final inclusivo; deve ser >= data_inicio."
          },
          {
            "name": "situacao",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "publicada",
                "cancelada"
              ]
            },
            "description": "Sem filtro: ambas as situações públicas."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Página fora do intervalo retorna 404."
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Quantidade de itens por página."
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta concluída",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaAtividades"
                },
                "example": {
                  "count": 1,
                  "next": null,
                  "previous": null,
                  "results": [
                    {
                      "id": 1,
                      "titulo": "Caminhada no parque",
                      "descricao": "Encontro gratuito para caminhada leve.",
                      "inicio": "2026-10-10T08:00:00-03:00",
                      "termino": "2026-10-10T10:00:00-03:00",
                      "capacidade": 20,
                      "vagas": 8,
                      "situacao": "publicada",
                      "encerrada": false,
                      "motivo_cancelamento": "",
                      "categoria": {
                        "id": 1,
                        "nome": "Caminhada"
                      },
                      "local": {
                        "id": 1,
                        "nome": "Parque Ibirapuera",
                        "endereco": "Av. Pedro Álvares Cabral, portão de encontro a confirmar",
                        "cidade": "São Paulo",
                        "uf": "SP",
                        "latitude": -23.5874,
                        "longitude": -46.6576
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": {
                    "codigo": "parametros_invalidos",
                    "mensagem": "Parâmetros inválidos",
                    "campos": {}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso ou página não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": {
                    "codigo": "nao_encontrado",
                    "mensagem": "Recurso ou página não encontrado",
                    "campos": {}
                  }
                }
              }
            }
          },
          "405": {
            "description": "Método não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": {
                    "codigo": "metodo_nao_permitido",
                    "mensagem": "Método não permitido",
                    "campos": {}
                  }
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string",
                  "example": "GET, HEAD, OPTIONS"
                }
              }
            }
          },
          "429": {
            "description": "Limite excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": {
                    "codigo": "limite_excedido",
                    "mensagem": "Limite excedido",
                    "campos": {}
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Segundos até nova tentativa.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "erro": {
                    "codigo": "erro_interno",
                    "mensagem": "Erro interno",
                    "campos": {}
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
