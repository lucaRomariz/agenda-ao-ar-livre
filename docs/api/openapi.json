  "components": {
    "schemas": {
      "Categoria": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nome"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "nome": {
            "type": "string",
            "maxLength": 60
          }
        }
      },
      "LocalPublico": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nome",
          "endereco",
          "cidade",
          "uf",
          "latitude",
          "longitude"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "nome": {
            "type": "string"
          },
          "endereco": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "uf": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Atividade": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titulo",
          "descricao",
          "inicio",
          "termino",
          "capacidade",
          "vagas",
          "situacao",
          "encerrada",
          "motivo_cancelamento",
          "categoria",
          "local"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "titulo": {
            "type": "string",
            "maxLength": 120
          },
          "descricao": {
            "type": "string"
          },
          "inicio": {
            "type": "string",
            "format": "date-time"
          },
          "termino": {
            "type": "string",
            "format": "date-time"
          },
          "capacidade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "vagas": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          },
          "situacao": {
            "type": "string",
            "enum": [
              "publicada",
              "cancelada"
            ]
          },
          "encerrada": {
            "type": "boolean"
          },
          "motivo_cancelamento": {
            "type": "string"
          },
          "categoria": {
            "$ref": "#/components/schemas/Categoria"
          },
          "local": {
            "$ref": "#/components/schemas/LocalPublico"
          }
        }
      },
      "Previsao": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atividade_id",
          "data",
          "estado",
          "min_c",
          "max_c",
          "probabilidade_chuva_pct",
          "codigo_wmo",
          "descricao",
          "consultado_em",
          "fonte",
          "url_fonte",
          "mensagem"
        ],
        "properties": {
          "atividade_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "data": {
            "type": "string",
            "format": "date"
          },
          "estado": {
            "type": "string",
            "enum": [
              "disponivel",
              "indisponivel",
              "fora_do_horizonte"
            ]
          },
          "min_c": {
            "type": "number",
            "nullable": true
          },
          "max_c": {
            "type": "number",
            "nullable": true
          },
          "probabilidade_chuva_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "nullable": true
          },
          "codigo_wmo": {
            "type": "integer",
            "nullable": true
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "consultado_em": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "fonte": {
            "type": "string",
            "enum": [
              "Open-Meteo"
            ]
          },
          "url_fonte": {
            "type": "string",
            "format": "uri"
          },
          "mensagem": {
            "type": "string"
          }
        },
        "description": "Nos estados indisponivel/fora_do_horizonte, valores meteorológicos e consultado_em são nulos. Disponivel exige valores não nulos. Resumo diário, não do horário do evento."
      },
      "Erro": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "codigo",
              "mensagem",
              "campos"
            ],
            "properties": {
              "codigo": {
                "type": "string",
                "enum": [
                  "parametros_invalidos",
                  "nao_encontrado",
                  "metodo_nao_permitido",
                  "limite_excedido",
                  "erro_interno"
                ]
              },
              "mensagem": {
                "type": "string"
              },
              "campos": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "PaginaAtividades": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "next",
          "previous",
          "results"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "next": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "previous": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Atividade"
            }
          }
        }
      }
    }
  }
}
